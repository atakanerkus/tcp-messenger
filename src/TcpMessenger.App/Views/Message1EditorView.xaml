<UserControl x:Class="TcpMessenger.App.Views.Message1EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TcpMessenger.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:Message1EditorViewModel, IsDesignTimeCreatable=False}">

    <StackPanel Margin="10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Mesaj ID" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="1" IsReadOnly="True" IsTabStop="False" Foreground="{StaticResource HintBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="int, 4 byte" Style="{StaticResource FieldHint}" />

            <TextBlock Grid.Row="1" Text="Birlik Referans No" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding UnitReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="M1_UnitReferenceNumber" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="−1000 … 9999" Style="{StaticResource FieldHint}" />

            <TextBlock Grid.Row="2" Text="Adı" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="M1_FirstName" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="≤ 25 byte UTF-8" Style="{StaticResource FieldHint}" />

            <TextBlock Grid.Row="3" Text="Unit No" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding UnitNo, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="M1_UnitNo" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="uint32" Style="{StaticResource FieldHint}" />

            <TextBlock Grid.Row="4" Text="Soyadı" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="M1_LastName" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="≤ 25 byte UTF-8" Style="{StaticResource FieldHint}" />

            <TextBlock Grid.Row="5" Text="Rütbe" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="5" Grid.Column="1"
                      ItemsSource="{Binding RankOptions}"
                      SelectedValue="{Binding Rank}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Display"
                      AutomationProperties.AutomationId="M1_Rank" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="short, 2 byte" Style="{StaticResource FieldHint}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Gönder"
                    Command="{Binding SendCommand}"
                    FontWeight="SemiBold"
                    AutomationProperties.AutomationId="M1_SendButton" />
            <TextBlock Text="Göndermek için bağlı olmalı ve tüm alanlar geçerli olmalı."
                       Style="{StaticResource FieldHint}"
                       TextWrapping="Wrap"
                       MaxWidth="220" />
        </StackPanel>
        <TextBlock Text="{Binding SendError}"
                   Style="{StaticResource ErrorText}"
                   Visibility="{Binding SendError, Converter={StaticResource NullToCollapsed}}"
                   AutomationProperties.AutomationId="M1_SendError" />

        <GroupBox Header="Periyodik gönderim">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Her"
                              IsChecked="{Binding IsPeriodic}"
                              AutomationProperties.AutomationId="M1_PeriodicCheckBox" />
                    <TextBox Width="70" Margin="8,0"
                             Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="M1_IntervalMs" />
                    <TextBlock Text="ms'de bir gönder" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding IntervalError}"
                           Style="{StaticResource ErrorText}"
                           Visibility="{Binding IntervalError, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
