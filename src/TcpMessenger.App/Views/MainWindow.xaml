<Window x:Class="TcpMessenger.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TcpMessenger.App.Views"
        xmlns:vm="clr-namespace:TcpMessenger.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding WindowTitle}"
        Width="1200" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">

    <DockPanel>

        <!-- Connection panel -->
        <views:ConnectionView DockPanel.Dock="Top" DataContext="{Binding Connection}" />

        <!-- Warning banner (undefined message, rejected client, lost connection, ...) -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="WarningBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Kapat"
                        Margin="12,0,0,0"
                        Command="{Binding DismissWarningCommand}"
                        AutomationProperties.AutomationId="DismissWarningButton" />
                <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding WarningText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="WarningText" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Connection.StatusText}" AutomationProperties.AutomationId="StatusText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock AutomationProperties.AutomationId="TransmitCountText">
                    <Run Text="Transmit:" /><Run Text="{Binding TrafficLog.TransmitCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock AutomationProperties.AutomationId="ReceiveCountText">
                    <Run Text="Receive:" /><Run Text="{Binding TrafficLog.ReceiveCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock AutomationProperties.AutomationId="UndefinedCountText">
                    <Run Text="Tanımsız:" /><Run Text="{Binding TrafficLog.UndefinedCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main area -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Left: message editors -->
            <DockPanel Grid.Column="0">
                <CheckBox DockPanel.Dock="Top"
                          Margin="0,0,0,8"
                          Content="Otomatik cevap (Mesaj 1 gelince Mesaj 2, Mesaj 2 gelince Mesaj 1 gönder)"
                          IsChecked="{Binding AutoReplyEnabled}"
                          AutomationProperties.AutomationId="AutoReplyCheckBox" />
                <TabControl AutomationProperties.AutomationId="MessageTabs">
                    <TabItem Header="{Binding Message1.Title}" AutomationProperties.AutomationId="Message1Tab">
                        <views:Message1EditorView DataContext="{Binding Message1}" />
                    </TabItem>
                    <TabItem Header="{Binding Message2.Title}" AutomationProperties.AutomationId="Message2Tab">
                        <views:Message2EditorView DataContext="{Binding Message2}" />
                    </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- Right: traffic list over detail pane -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="270" MinHeight="140" />
                </Grid.RowDefinitions>

                <views:TrafficLogView Grid.Row="0" DataContext="{Binding TrafficLog}" />
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" />
                <views:MessageDetailView Grid.Row="2" DataContext="{Binding Detail}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
